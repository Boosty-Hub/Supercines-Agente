      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      cartelera: items.map(item => {\n        const data = item.json;\n\n        return {\n          fecha: data.fecha,\n          dia_semana: data.dia_semana,\n          peliculas: (data.peliculas || []).map(p => ({\n            nombre: p.nombre,\n            idioma: p.idioma,\n            censura: p.censura,\n            fechaEstreno: p.fechaEstreno,\n            horarios: (p.horarios || []).map(h => h.hora)\n          }))\n        };\n      })\n    }\n  }\n];"
